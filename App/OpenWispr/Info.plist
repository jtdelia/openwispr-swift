<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>OpenWispr</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>OpenWispr</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>27.0</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSAppleEventsUsageDescription</key>
	<string>OpenWispr pastes your dictations into the app you are using.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>OpenWispr records the call audio of meetings you ask it to take notes in.</string>
	<key>NSHumanReadableCopyright</key>
	<string>MIT License</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>OpenWispr connects to model servers you run on your local network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>OpenWispr records your voice while you dictate and while it takes meeting notes.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>OpenWispr uses Apple’s on-device speech recognition to transcribe your dictations and meetings.</string>
</dict>
</plist>
